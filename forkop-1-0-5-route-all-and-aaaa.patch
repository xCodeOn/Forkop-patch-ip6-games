+    push(dns_servers, fakeip_server);
 
     runtime_context = object_or_empty(runtime_context);
     let inbounds = [
@@ -461,6 +478,23 @@ function base_config(settings, service_address, runtime_context) {
     runtime_context.dns_health_inbounds = dns_config.sniff_inbounds;
     runtime_context.default_domain_resolver = runtime_dns.default_domain_resolver(settings);
 
+    // Without a global IPv6 address nothing an AAAA answer points to is reachable, and a
+    // client that dials one first, a game client over UDP among them, hangs. The fakeip
+    // server answers AAAA queries with an empty response when it has no inet6 range, and
+    // this rule catches the AAAA queries no domain rule takes, upstream answers included.
+    if (!ipv6_global_address_present()) {
