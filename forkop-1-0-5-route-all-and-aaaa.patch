+// Whether any interface holds a global IPv6 address (2000::/3), which is what makes an
+// AAAA answer point somewhere reachable. A ULA address does not count: without a global
+// one, no AAAA answer the network can hand out is any good.
+function ipv6_global_address_present() {
+    let text = fs.readfile("/proc/net/if_inet6");
+    if (text == null)
+        return false;
+    for (let line in split(text, "\n")) {
+        let fields = split(replace(trim(line), /[[:space:]]+/g, " "), " ");
+        if (length(fields) > 0 && match(fields[0], /^[23]/) != null)
+            return true;
+    }
+    return false;
+}
+
 function base_config(settings, service_address, runtime_context) {
     let log_level = option(settings, "log_level", "warn");
     let rewrite_ttl = int_option(settings, "dns_rewrite_ttl", "60");
