-        inet4_range: runtime_constants.FAKEIP_INET4_RANGE,
-        inet6_range: runtime_constants.FAKEIP_INET6_RANGE
-    });
+        inet4_range: runtime_constants.FAKEIP_INET4_RANGE
+    };
+    if (ipv6_global_address_present())
