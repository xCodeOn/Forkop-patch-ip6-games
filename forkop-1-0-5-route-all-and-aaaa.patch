+// it comes after every section rule, so Block and Bypass sections stay exceptions.
+function add_route_all_rule(config, settings, sections) {
+    if (!bool_option(settings, "route_all_enabled", false))
+        return;
+
+    let section_name = option(settings, "route_all_section", "");
+    if (section_name == "")
+        return;
+
+    let target = null;
+    for (let section in sections)
