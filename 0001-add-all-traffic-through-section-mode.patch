diff --git a/tests/singbox/generator_route_all.test.uc b/tests/singbox/generator_route_all.test.uc
new file mode 100644
index 00000000..745d340c
--- /dev/null
+++ b/tests/singbox/generator_route_all.test.uc
@@ -0,0 +1,87 @@
+let t = require("t");
+let fixture = require("fixture");
+let generator = require("singbox.generator");
+let q = require("sbconfig");
+
+function build(data, context) {
+    fixture.seed(data);
+    return generator.build(context ?? { service_address: "127.0.0.1" });
+}
+
+function refused(data) {
+    return t.throws(() => build(data)).message;
+}
+
+function section(name, extra) {
+    return { ".name": name, enabled: "1", action: "connection", outbound_jsons: [ "{\"type\":\"direct\"}" ], ...(extra ?? {}) };
+}
+
+const TPROXY_INBOUNDS = [ "tproxy-in", "tproxy6-in", "system-in", "system6-in" ];
+
+function is_route_all_rule(r) {
+    return r.outbound == "vpn" && r.domain == null &&
+        r.ip_cidr == null && r.source_ip_cidr == null && r.inbound != null;
+}
+
+function route_all_rule(config) {
+    return q.route_rule(config, is_route_all_rule);
+}
+
+t.test("route-all sends what no section matched through its section, after them", () => {
+    let d = build({
+        settings: fixture.settings({ route_all_enabled: "1", route_all_section: "vpn" }),
+        section: [ section("vpn"), section("narrow", { destinations: "203.0.113.0/24" }) ]
+    });
+    let all = route_all_rule(d);
+    t.eq(all.action, "route");
+    t.eq(all.inbound, TPROXY_INBOUNDS, "every captured inbound, the clients and the router");
+
+    let narrow_at = q.route_rule_index(d, (r) => r.outbound == "narrow" && r.ip_cidr != null && index(r.ip_cidr, "203.0.113.0/24") >= 0);
+    t.ok(narrow_at >= 0, "the narrow section rule exists");
+    t.ok(q.route_rule_index(d, is_route_all_rule) > narrow_at, "sections keep their priority over route-all");
+    t.ok(q.route_rule_index(d, (r) => r.domain == "ip.podkop.fyi") < q.route_rule_index(d, is_route_all_rule),
+        "the exit check keeps the section it names");
+});
+
+t.test("route-all stays off unless the settings ask for it", () => {
+    let off = build({ settings: fixture.settings({ route_all_section: "vpn" }), section: [ section("vpn") ] });
+    t.eq(route_all_rule(off), null, "the flag is off");
+
+    let empty = build({ settings: fixture.settings({ route_all_enabled: "1" }), section: [ section("vpn") ] });
+    t.eq(route_all_rule(empty), null, "the flag is on, but no section is selected");
+});
+
+t.test("route-all refuses a target that is not an enabled connection section", () => {
+    t.eq(refused({ settings: fixture.settings({ route_all_enabled: "1", route_all_section: "gone" }),
+        section: [ section("vpn") ] }), "all traffic section 'gone' is not an enabled connection section");
+    t.eq(refused({ settings: fixture.settings({ route_all_enabled: "1", route_all_section: "off" }),
+        section: [ section("vpn"), section("off", { enabled: "0" }) ] }),
+        "all traffic section 'off' is not an enabled connection section");
+    t.eq(refused({ settings: fixture.settings({ route_all_enabled: "1", route_all_section: "deny" }),
+        section: [ section("vpn"), { ".name": "deny", enabled: "1", action: "block", destinations: "ads.example" } ] }),
+        "all traffic section 'deny' is not an enabled connection section");
+});
+
+t.test("route-all resolves the main DNS through its section", () => {
+    let d = build({ settings: fixture.settings({ route_all_enabled: "1", route_all_section: "vpn" }), section: [ section("vpn") ] });
+    let main = q.dns_server_tag(d, "dns-server");
+    for (let tag in main.servers)
+        t.eq(q.dns_server_tag(d, tag).detour, "vpn", "the main server goes through the section");
+    t.eq(d.route.default_domain_resolver, "bootstrap-dns-server",
+        "the sections' own server names resolve through the bootstrap, never through the section");
+
+    let explicit = build({ settings: fixture.settings({ route_all_enabled: "1", route_all_section: "vpn",
+        dns_detour_enabled: "1", dns_detour_section: "other" }),
+        section: [ section("vpn"), section("other") ] });
+    let other = q.dns_server_tag(explicit, "dns-server");
+    for (let tag in other.servers)
+        t.eq(q.dns_server_tag(explicit, tag).detour, "other", "an explicit DNS detour wins over route-all");
+
+    let plain = build({ settings: fixture.settings(), section: [ section("vpn") ] });
+    let direct = q.dns_server_tag(plain, "dns-server");
+    for (let tag in direct.servers)
+        t.eq(q.dns_server_tag(plain, tag).detour, null, "without the modes the main DNS goes nowhere special");
+    t.eq(plain.route.default_domain_resolver, "dns-server");
+});
+
+t.done();
