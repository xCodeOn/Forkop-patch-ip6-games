--- a/tests/lib/fixture.uc
+++ b/tests/lib/fixture.uc
@@ -61,6 +61,9 @@ function seed(data) {
         uci.__seed("dhcp", [ { ".type": "dnsmasq", ...data.dhcp_dnsmasq } ]);
     if (data.system_ntp != null)
         uci.__seed("system", [ { ".type": "timeserver", ".name": "ntp", ...data.system_ntp } ]);
+
+    // A global IPv6 address by default, which is what most networks and tests assume.
+    ipv6_global_address(true);
 }
 
 // The settings every generated configuration needs, merged with the test's own.
@@ -86,4 +89,15 @@ function kernel_ipv6(interfaces) {
     }
