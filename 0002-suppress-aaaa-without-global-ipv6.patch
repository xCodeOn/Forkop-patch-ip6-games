 };
 
 let as_string = common.as_string;
@@ -165,6 +166,21 @@ function ipv6_enabled() {
     return length(ipv6_interfaces() ?? []) > 0;
 }
 
+// Whether any interface holds a global IPv6 address (2000::/3), which is what makes an
+// AAAA answer point somewhere reachable. A ULA address does not count: without a global
+// one, no AAAA answer the network can hand out is any good.
+function ipv6_global_address_present() {
+    let text = fs.readfile(paths.if_inet6);
+    if (text == null)
+        return false;
+    for (let line in split(text, "\n")) {
+        let fields = normalized_fields(line);
+        if (length(fields) > 0 && match(fields[0], /^[23]/) != null)
+            return true;
+    }
+    return false;
+}
+
 function tproxy_route4_present(table) {
     return has_local_default_route_text(command_output_from_args([ IP_BIN, "route", "list", "table", table ]), 4);
 }
