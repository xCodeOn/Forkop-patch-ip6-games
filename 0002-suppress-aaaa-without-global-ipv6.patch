-return { seed, settings, links, kernel_ipv6 };
+// Whether the test network holds a global IPv6 address (2000::/3), which is what the
+// generator reads from /proc to decide on AAAA answers. Default is present, as on the
+// networks most setups have; the AAAA suppression tests write a ULA-only one over this.
+function ipv6_global_address(present) {
+    let state = require("nft.state");
+    state.paths.if_inet6 = require("stub").tmpdir() + "/if_inet6";
+    fs.writefile(state.paths.if_inet6, present
+        ? "2001:db8::1 2 eth0 00\n"
+        : "fd84:2881:b789::1 2 br-lan 60 40\n");
+}
+
+return { seed, settings, links, kernel_ipv6, ipv6_global_address };
diff --git a/tests/singbox/generator_dns.test.uc b/tests/singbox/generator_dns.test.uc
index 8b218993..c4caf1f4 100644
--- a/tests/singbox/generator_dns.test.uc
+++ b/tests/singbox/generator_dns.test.uc
@@ -226,4 +226,31 @@ t.test("DNS timeout reaches the core as configured", () => {
     t.eq(config.experimental.cache_file.store_subscriptions, true);
 });
 
+t.test("without a global IPv6 address the LAN receives no AAAA answers", () => {
+    fixture.seed({
+        settings: { dns_server: [ "77.88.8.8" ], bootstrap_dns_server: [ "77.88.8.8" ] },
+        section: [ { ".name": "direct", enabled: "1", action: "bypass", destinations: "example.org" } ]
+    });
+    fixture.ipv6_global_address(false);
+    let d = generator.build({ service_address: "192.168.1.1" });
+    t.eq(q.dns_server_tag(d, "fakeip-server").inet6_range, null, "the fakeip server holds no v6 pool");
+    let first = d.dns.rules[0];
+    t.eq([ first.inbound, first.query_type, first.server, first.action ],
+        [ [ "source-dns-in", "system-dns-in" ], [ "AAAA" ], "fakeip-server", "route" ],
+        "every AAAA query the LAN asks ends in an empty answer");
+    t.eq(q.dns_server_tag(d, "fakeip-server").inet4_range, "198.18.0.0/16", "the v4 pool stays");
+});
+
+t.test("a global IPv6 address keeps the AAAA answers as they were", () => {
+    fixture.seed({
+        settings: { dns_server: [ "77.88.8.8" ], bootstrap_dns_server: [ "77.88.8.8" ] },
+        section: [ { ".name": "direct", enabled: "1", action: "bypass", destinations: "example.org" } ]
+    });
+    fixture.ipv6_global_address(true);
+    let d = generator.build({ service_address: "192.168.1.1" });
+    t.eq(q.dns_server_tag(d, "fakeip-server").inet6_range, "2001:2::/112");
+    t.eq(q.dns_rule(d, (r) => r.inbound != null && r.query_type != null &&
+        length(r.query_type) == 1 && r.query_type[0] == "AAAA"), null, "no catch-all AAAA rule");
+});
+
 t.done();
